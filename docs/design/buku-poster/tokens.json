{
  "name": "Carakan · Buku Poster",
  "version": "1.0",
  "notes": "All sizes are logical pixels at a 390 x 844 reference frame. Corner radius is 0 everywhere except the stamps (circle).",
  "color": {
    "paper": { "value": "#F7F3EA", "role": "App background (under the ruled lines)" },
    "card": { "value": "#FFFDF8", "role": "Raised surfaces: tiles, inputs, answer buttons, tracing pad" },
    "rule": { "value": "#DAE3EC", "role": "Ruled-paper lines, 1px every 36px" },
    "margin": { "value": "#E39484", "role": "Notebook margin line (2px, 80% opacity) and tracing guide lines (dashed)" },
    "ink": { "value": "#2F3456", "role": "Text, borders, hard shadows, primary buttons, active nav tab" },
    "inkMuted": { "value": "#4A4F6E", "role": "Secondary text, inactive nav labels, small captions" },
    "inkSubtle": { "value": "#5E6380", "role": "Tertiary text on card surfaces" },
    "hand": { "value": "#8C5A3C", "role": "Handwritten notes (Patrick Hand)" },
    "stamp": { "value": "#9E4F3F", "role": "Text stamps that carry meaning, e.g. BENAR!" },
    "stampDecor": { "value": "#C0604E", "role": "Decorative stamps only (aria-hidden), e.g. AYO MULAI" },
    "placeholder": { "value": "#A3ABCF", "role": "Dashed empty slots, ghost tracing outline, not-yet-seen glyph chips. Not for readable text." },
    "onInk": { "value": "#F7F3EA", "role": "Text and icons on ink surfaces" },
    "accent": {
      "coral": { "value": "#F08A6C", "role": "Kelompok 1, current lesson, primary highlight" },
      "periwinkle": { "value": "#9DB0EF", "role": "Kelompok 2, quiz card, secondary highlight" },
      "butter": { "value": "#F6CF63", "role": "Kelompok 3, sound buttons, settings button" },
      "sage": { "value": "#8FC9A8", "role": "Correct answer, review, memory-strength fill" },
      "neutral": { "value": "#ECE6D9", "role": "Chart tiles for groups not yet defined" }
    },
    "tape": { "value": "rgba(246,207,99,0.85)", "role": "Washi tape strip on hero cards" },
    "scrim": { "value": "rgba(47,52,86,0.45)", "role": "Backdrop behind bottom sheets" }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "weights": [500, 700, 800], "role": "Headings, labels, buttons, Latin syllables" },
    "hand": { "family": "Patrick Hand", "weights": [400], "role": "Teacher-style notes, hints, stamps. Never for primary actions." },
    "aksara": { "family": "Noto Sans Javanese", "weights": [400, 600, 700], "role": "All Javanese script (U+A980–U+A9DF)" }
  },
  "type": {
    "screenTitle": { "font": "display", "size": 44, "weight": 800, "lineHeight": 0.92, "letterSpacing": "-0.04em", "note": "Two lines, ends with a period: 'Sinau / aksara.'" },
    "syllableXL": { "font": "display", "size": 64, "weight": 800, "lineHeight": 0.9, "letterSpacing": "-0.04em" },
    "syllableL": { "font": "display", "size": 40, "weight": 800, "lineHeight": 0.95, "letterSpacing": "-0.03em" },
    "cardTitle": { "font": "display", "size": 20, "weight": 800, "lineHeight": 1.0 },
    "button": { "font": "display", "size": 18, "weight": 800 },
    "body": { "font": "display", "size": 16, "weight": 700 },
    "eyebrow": { "font": "display", "size": 13, "weight": 800, "letterSpacing": "0.08em", "transform": "uppercase" },
    "caption": { "font": "display", "size": 12, "weight": 700 },
    "navLabel": { "font": "display", "size": 13, "weight": 700, "activeWeight": 800 },
    "handNote": { "font": "hand", "size": 20, "range": "17–22" },
    "aksaraHero": { "font": "aksara", "size": 210, "range": "190–230" },
    "aksaraTile": { "font": "aksara", "size": 30 },
    "aksaraInline": { "font": "aksara", "size": 32, "range": "28–36" }
  },
  "space": { "screenGutter": 18, "notebookGutterLeft": 44, "gap": [6, 8, 10, 12, 14, 16, 22, 24], "sectionGap": 24 },
  "border": { "width": 2, "color": "ink", "dashedEmpty": "2px dashed placeholder", "radius": 0 },
  "shadow": {
    "hero": "5px 5px 0 ink",
    "tile": "3px 3px 0 ink",
    "small": "3px 3px 0 ink",
    "note": "Hard offset shadows only. No blur."
  },
  "size": {
    "minTouch": 44,
    "iconButton": 44,
    "soundButtonLarge": 64,
    "bottomBar": 68,
    "navBar": 64,
    "chartTile": { "height": 92, "labelStrip": 26 },
    "answerTile": { "height": 96 },
    "progressSegment": { "height": 12 }
  },
  "texture": {
    "ruledPaper": "repeating-linear-gradient(to bottom, transparent 0 35px, rule 35px 36px) over paper",
    "marginLine": "2px vertical line at x=30, color margin, opacity 0.8 (Learn path only)"
  }
}
