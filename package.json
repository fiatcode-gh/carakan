{
  "name": "carakan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/engine/tsconfig.json --noEmit",
    "gen:codepoints": "node tools/gen-codepoints.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:dump": "sh tools/parity/dump-dart.sh",
    "shaping": "sh tools/shaping/run.sh",
    "fonts": "sh tools/fonts/subset.sh",
    "icons": "node tools/icons/render.ts",
    "gen:content": "node tools/gen-content.ts",
    "served:up": "sh tools/served/up.sh",
    "served:down": "sh tools/served/down.sh",
    "served:headers": "node tools/served/check-headers.ts",
    "served:measure": "node tools/served/measure-served.ts",
    "measure": "node tools/measure-transfer.ts",
    "lighthouse": "node tools/lighthouse.ts",
    "test:e2e:served": "E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:8090/} playwright test tests/e2e/shell.spec.ts tests/e2e/offline.spec.ts tests/e2e/a11y.spec.ts --project=mobile"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "svelte": "^5.57.1",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
