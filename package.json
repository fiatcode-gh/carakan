{
  "name": "carakan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "gen:codepoints": "node tools/gen-codepoints.ts",
    "check": "tsc -p src/engine/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:dump": "sh tools/parity/dump-dart.sh",
    "shaping": "sh tools/shaping/run.sh",
    "gen:content": "node tools/gen-content.ts",
    "prototype": "vite --config prototype/vite.config.ts --port 5180 --strictPort",
    "prototype:capture": "node prototype/capture.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "svelte": "^5.57.1"
  }
}
