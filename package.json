{
  "name": "carakan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/engine/tsconfig.json --noEmit",
    "gen:codepoints": "node tools/gen-codepoints.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity:dump": "sh tools/parity/dump-dart.sh",
    "shaping": "sh tools/shaping/run.sh",
    "fonts": "sh tools/fonts/subset.sh",
    "gen:content": "node tools/gen-content.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "svelte": "^5.57.1"
  }
}
